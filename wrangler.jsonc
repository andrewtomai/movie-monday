{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "movie-monday",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
