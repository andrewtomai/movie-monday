{
  "name": "movie-monday",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "preview": "yarn run build && wrangler dev",
    "deploy": "yarn run build && wrangler deploy",
    "prepare": "husky",
    "db:migration:create": "drizzle-kit generate",
    "db:migration:apply": "wrangler d1 migrations apply misc-movie-club-prod"
  },
  "dependencies": {
